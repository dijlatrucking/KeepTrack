rules_version = '2';

// KeepTrack access model
//   owner         – sees and edits everything
//   dispatcher    – works only the carriers the owner assigns (or all, if allCarriers is on)
//   carrierAdmin  – sees only their own company: loads, money, drivers, trucks, approved docs
//   driver        – sees only their own loads, uploads and paystubs (never rates or fees)
// Load money lives in /loadMoney so drivers can read their loads without seeing rates.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function invitePath(code) { return /databases/$(database)/documents/invites/$(code); }
    function hasProfile() { return signedIn() && exists(userPath(request.auth.uid)); }
    function me() { return get(userPath(request.auth.uid)).data; }
    function isRole(r) { return hasProfile() && me().role == r; }
    function isOwner() { return isRole('owner'); }
    function dispatches(cid) {
      return isRole('dispatcher')
        && (me().get('allCarriers', false) == true || cid in me().get('assignedCarriers', []));
    }
    function isCarrierAdmin(cid) { return isRole('carrierAdmin') && me().get('carrierId', '') == cid; }
    function isDriverIn(cid) { return isRole('driver') && me().get('carrierId', '') == cid; }
    function staff(cid) { return isOwner() || dispatches(cid); }
    function manages(cid) { return staff(cid) || isCarrierAdmin(cid); }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function keepsCarrier() { return request.resource.data.carrierId == resource.data.carrierId; }

    // Sign-up must redeem an unused invite in the same batch, and copy its role + carrier exactly.
    function redeemsInvite(d) {
      let before = get(invitePath(d.invite)).data;
      let after = getAfter(invitePath(d.invite)).data;
      return before.used == false
        && after.used == true && after.usedBy == request.auth.uid
        && d.role == before.role
        && d.get('carrierId', null) == before.get('carrierId', null);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner()
        || manages(resource.data.get('carrierId', '')));
      allow create: if (signedIn() && request.auth.uid == uid && (
           // Invite code: role and carrier come from the invite.
           (request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'role', 'carrierId', 'invite', 'createdAt'])
            && redeemsInvite(request.resource.data))
           // No code: request access and wait as "pending" until the owner approves.
        || (request.resource.data.role == 'pending'
            && request.resource.data.requestedRole in ['carrierAdmin', 'dispatcher']
            && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'role', 'requestedRole', 'company', 'mc', 'dot', 'note', 'createdAt']))))
        // A driver added by hand (no app login). The id can never match a real sign-in.
        || (uid.matches('^manual_[a-z0-9]{8,40}$')
            && request.resource.data.role == 'driver' && request.resource.data.manual == true
            && (isOwner() || isCarrierAdmin(request.resource.data.carrierId))
            && request.resource.data.keys().hasOnly(['role', 'manual', 'carrierId', 'name', 'phone', 'payType', 'payRate', 'truckId', 'truckUnit', 'createdAt']));
      allow update: if isOwner()
        || (request.auth.uid == uid && onlyChanges(['name', 'phone']))
        || (resource.data.role == 'driver' && isCarrierAdmin(resource.data.get('carrierId', ''))
            && onlyChanges(['name', 'phone', 'payType', 'payRate', 'truckId', 'truckUnit', 'active']));
      allow delete: if isOwner()
        || (resource.data.role == 'driver' && isCarrierAdmin(resource.data.get('carrierId', '')));
    }

    match /invites/{code} {
      // Anyone signed in may look up one code they already hold; only issuers may list them.
      allow get: if signedIn();
      allow list: if isOwner() || isCarrierAdmin(resource.data.get('carrierId', ''));
      allow create: if request.resource.data.used == false
        && request.resource.data.createdBy == request.auth.uid
        && (isOwner()
            || (request.resource.data.role == 'driver' && isCarrierAdmin(request.resource.data.carrierId)));
      allow update: if signedIn() && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && onlyChanges(['used', 'usedBy', 'usedAt'])
        && getAfter(userPath(request.auth.uid)).data.invite == code;
      allow delete: if isOwner() || isCarrierAdmin(resource.data.get('carrierId', ''));
    }

    match /carriers/{cid} {
      allow read: if manages(cid) || isDriverIn(cid);
      allow write: if isOwner();
      // carrier admins keep their own factoring + alert settings; name, MC/DOT and dispatch fee % stay with the owner
      allow update: if isCarrierAdmin(cid) && onlyChanges(['factorName', 'factorPct', 'ageDays', 'countBy', 'phone']);
    }

    match /trucks/{id} {
      allow read: if manages(resource.data.carrierId) || isDriverIn(resource.data.carrierId);
      allow create: if isOwner() || isCarrierAdmin(request.resource.data.carrierId);
      allow update: if (isOwner() || isCarrierAdmin(resource.data.carrierId)) && keepsCarrier();
      allow delete: if isOwner() || isCarrierAdmin(resource.data.carrierId);
    }

    match /loads/{id} {
      allow read: if manages(resource.data.carrierId)
        || (isDriverIn(resource.data.carrierId) && resource.data.driverId == request.auth.uid);
      // carrier admins may also book their own loads (no dispatcher, no dispatch fee) and keep their loads up to date
      allow create: if staff(request.resource.data.carrierId)
        || (isCarrierAdmin(request.resource.data.carrierId) && request.resource.data.get('dispatcherId', null) == null);
      allow update: if (staff(resource.data.carrierId) && keepsCarrier())
        || (isCarrierAdmin(resource.data.carrierId) && keepsCarrier()
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['dispatcherId', 'dispatcherName']))
        || (isDriverIn(resource.data.carrierId) && resource.data.driverId == request.auth.uid
            && onlyChanges(['status', 'updatedAt'])
            && request.resource.data.status in ['in_transit', 'delivered']);
      // carrier admins may delete loads they booked themselves (never one dispatch booked)
      allow delete: if isOwner()
        || (isCarrierAdmin(resource.data.carrierId) && resource.data.get('dispatcherId', null) == null);
    }

    match /loadMoney/{id} {
      allow read: if manages(resource.data.carrierId);
      allow create: if staff(request.resource.data.carrierId)
        || (isCarrierAdmin(request.resource.data.carrierId) && request.resource.data.get('fee', 0) == 0 && request.resource.data.get('feePaid', false) == false);
      // carrier admins record factoring + deposits; they can't touch the dispatch fee, and can only change the
      // rate on loads they booked themselves (no dispatch fee)
      allow update: if (staff(resource.data.carrierId) && keepsCarrier())
        || (isCarrierAdmin(resource.data.carrierId) && keepsCarrier()
            && (onlyChanges(['factored', 'deposit'])
                || (resource.data.get('fee', 0) == 0 && onlyChanges(['rate', 'factored', 'deposit']))));
      allow delete: if isOwner()
        || (isCarrierAdmin(resource.data.carrierId) && resource.data.get('fee', 0) == 0);
    }

    // Carrier bookkeeping: expenses and recurring charges. Owner + that carrier's admin only.
    match /expenses/{id} {
      allow read: if isOwner() || isCarrierAdmin(resource.data.carrierId);
      allow create: if isOwner() || isCarrierAdmin(request.resource.data.carrierId);
      allow update: if (isOwner() || isCarrierAdmin(resource.data.carrierId)) && keepsCarrier();
      allow delete: if isOwner() || isCarrierAdmin(resource.data.carrierId);
    }
    match /recurring/{id} {
      allow read: if isOwner() || isCarrierAdmin(resource.data.carrierId);
      allow create: if isOwner() || isCarrierAdmin(request.resource.data.carrierId);
      allow update: if (isOwner() || isCarrierAdmin(resource.data.carrierId)) && keepsCarrier();
      allow delete: if isOwner() || isCarrierAdmin(resource.data.carrierId);
    }

    // Paperwork flows up: driver uploads (pending) → dispatch approves → carrier + owner see it.
    match /documents/{id} {
      // Driver uploads reach dispatch and the carrier at the same time; either can approve or reject.
      allow read: if staff(resource.data.carrierId)
        || isCarrierAdmin(resource.data.carrierId)
        || (hasProfile() && resource.data.uploadedBy == request.auth.uid
            && me().get('carrierId', '') == resource.data.carrierId);
      // a paper can only be filed under a load that exists and belongs to the same carrier
      allow create: if request.resource.data.uploadedBy == request.auth.uid
        && (request.resource.data.get('loadId', null) == null
            || get(/databases/$(database)/documents/loads/$(request.resource.data.loadId)).data.carrierId == request.resource.data.carrierId)
        && (
           (isDriverIn(request.resource.data.carrierId) && request.resource.data.status == 'pending')
        || (isCarrierAdmin(request.resource.data.carrierId) && request.resource.data.status == 'filed')
        || staff(request.resource.data.carrierId));
      // A paper can only be moved to one of the same carrier's loads.
      function loadFits() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['loadId'])
          || request.resource.data.get('loadId', null) == null
          || get(/databases/$(database)/documents/loads/$(request.resource.data.loadId)).data.carrierId == resource.data.carrierId;
      }
      allow update: if (staff(resource.data.carrierId) && keepsCarrier() && loadFits())
        // carrier admins fix the details of their company's papers (type, name, load, amount, note, tags, expiry)
        || (isCarrierAdmin(resource.data.carrierId) && keepsCarrier() && loadFits()
            && onlyChanges(['name', 'category', 'kind', 'tags', 'expiresAt', 'note', 'amount', 'receiptType', 'loadId', 'loadLabel']))
        || (isCarrierAdmin(resource.data.carrierId) && resource.data.status == 'pending'
            && request.resource.data.status in ['approved', 'rejected']
            && onlyChanges(['status', 'rejectReason', 'reviewedBy', 'reviewedAt', 'expenseId', 'amount']));
      // owner: anything; carrier admin: their company's papers; driver: their own upload before it's reviewed
      allow delete: if isOwner()
        || isCarrierAdmin(resource.data.carrierId)
        || (isDriverIn(resource.data.carrierId) && resource.data.uploadedBy == request.auth.uid && resource.data.status == 'pending');
    }

    // The scan itself (a shrunk image or small PDF), stored beside its /documents record with the same id.
    // Readable by exactly the people who can read that document.
    match /docFiles/{id} {
      function docMeta() { return get(/databases/$(database)/documents/documents/$(id)).data; }
      allow get: if hasProfile() && (
           staff(docMeta().carrierId)
        || isCarrierAdmin(docMeta().carrierId)
        || (docMeta().uploadedBy == request.auth.uid && me().get('carrierId', '') == docMeta().carrierId));
      allow create: if hasProfile()
        && request.resource.data.uploadedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/documents/$(id)).data.uploadedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/documents/$(id)).data.carrierId == request.resource.data.carrierId;
      // The owner may remove a scan on its own (after it's safely in Drive). Everyone else only deletes it
      // together with its /documents record, and only if they may delete that record.
      allow delete: if isOwner() || (hasProfile()
        && !existsAfter(/databases/$(database)/documents/documents/$(id))
        && (isCarrierAdmin(docMeta().carrierId)
            || (isDriverIn(docMeta().carrierId) && docMeta().uploadedBy == request.auth.uid && docMeta().status == 'pending')));
    }

    match /requests/{id} {
      allow read: if manages(resource.data.carrierId);
      allow create: if request.resource.data.createdBy == request.auth.uid
        && (isOwner() || isCarrierAdmin(request.resource.data.carrierId));
      allow update: if staff(resource.data.carrierId)
        && onlyChanges(['status', 'reply', 'repliedBy', 'repliedAt']);
      allow delete: if isOwner();
    }

    // App-wide settings (e.g. the Google Drive script URL). Everyone signed in can read; only the owner changes them.
    match /settings/{id} {
      allow read: if hasProfile();
      allow write: if isOwner();
    }

    match /paystubs/{id} {
      allow read: if isOwner() || isCarrierAdmin(resource.data.carrierId)
        || (isDriverIn(resource.data.carrierId) && resource.data.driverId == request.auth.uid);
      allow create: if isOwner() || isCarrierAdmin(request.resource.data.carrierId);
      allow update: if (isOwner() || isCarrierAdmin(resource.data.carrierId)) && keepsCarrier();
      allow delete: if isOwner() || isCarrierAdmin(resource.data.carrierId);
    }
  }
}
